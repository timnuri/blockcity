# Пороги медалей [золото, серебро] — подобраны ботом (tests/balance.gd), см. HANDOFF.md.
# 0.2: уровни 1–10 смягчены по отзыву Тима (золото = прежнее серебро + 1).
const MEDALS := [
	[14, 19], [19, 24], [17, 22], [23, 28], [29, 34],
	[21, 22], [26, 30], [29, 32], [22, 27], [22, 27],
	[24, 28], [12, 16], [20, 25], [21, 25], [10, 14],
	[20, 25], [9, 13], [10, 16], [32, 42], [30, 42],
]


static func count() -> int:
	return LIST.size()


static func get_level(n: int) -> Dictionary:
	var d: Dictionary = LIST[n - 1].duplicate(true)
	d["num"] = n
	d["medals"] = MEDALS[n - 1]
	return d


## Цели с подставленными числами для «все на поле».
static func resolve_goals(level: Dictionary, board: Board) -> Array:
	var out: Array = []
	for g in level.goals:
		var n: int = g.n
		if n == 0 and g.t == "ice":
			n = board.count_ice()
		elif n == 0 and g.t == "boxes":
			n = board.count_boxes()
		out.append({"t": g.t, "n": n})
	return out


static func progress(goal: Dictionary, board: Board) -> int:
	match goal.t:
		"score": return board.score
		"lines": return board.lines_total
		"ice": return board.ice_broken
		"boxes": return board.boxes_destroyed
	return 0


static func done(goals: Array, board: Board) -> bool:
	for g in goals:
		if progress(g, board) < g.n:
			return false
	return true


## 3 — золото, 2 — серебро, 1 — бронза.
static func medal_for(level: Dictionary, moves_used: int) -> int:
	var m: Array = level.medals
	if moves_used <= m[0]:
		return 3
	if moves_used <= m[1]:
		return 2
	return 1


static func goal_name(t: String) -> String:
	match t:
		"score": return "Очки"
		"lines": return "Линии"
		"ice": return "Лёд"
		"boxes": return "Ящики"
	return t
